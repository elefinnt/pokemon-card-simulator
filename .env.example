# Pokémon TCG API key.
# Optional, but strongly recommended: without a key you are limited to
# 1,000 requests/day (30/min). With a free key the limit is 20,000/day.
# Register for a free key at https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=your_key_here

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here

# Discord OAuth — create an app at https://discord.com/developers/applications
# Redirect URL: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=your_discord_client_id
AUTH_DISCORD_SECRET=your_discord_client_secret

# Railway MySQL connection string
# DATABASE_URL=mysql://user:password@host:port/database

# Site owner access — comma-separated list of sign-in emails allowed to view
# admin pages such as /admin/feedback (case-insensitive).
# ADMIN_EMAILS=you@example.com

# Telegram alerts for new feedback. Create a bot with @BotFather, then message
# it once and read chat.id from https://api.telegram.org/bot<token>/getUpdates.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789

# Pack-opening safeguards. Run `pnpm db:setup-pack-limits` once before deploying.
# Counters are shared through MySQL across tabs and serverless instances.
# PACK_OPEN_PER_MINUTE=30
# PACK_OPEN_PER_HOUR=300
# Guests are limited by Vercel's trusted client IP, shared across guest sessions.
# PACK_GUEST_PER_MINUTE=12
# PACK_GUEST_PER_HOUR=60
# Pause only openings while keeping browsing and collections available.
# PACK_OPENINGS_PAUSED=false
# All-set warm-up is off on serverless; enable only on a long-running server.
# WARM_ALL_POOLS=false
# Optional live refresh for committed card pools; normally regenerate snapshots.
# LIVE_POOL_REFRESH=false
